# Browser key: restrict to Books API and your website before use.
# This value is included in the public browser bundle.
VITE_GOOGLE_BOOKS_API_KEY=


# These browser values are public after building. Keep the real values outside Git.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Development only. Never connect local tests to production.
VITE_FIREBASE_EMULATORS=false
